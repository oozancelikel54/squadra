{
  "expo": {
    "name": "Squadra",
    "slug": "squadra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squadra.squadraapp",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Kadro görüntüsünü galeriye kaydetmek için izin gerekli.",
        "NSPhotoLibraryUsageDescription": "Kadro görüntüsünü galeriye kaydetmek için izin gerekli."
      }
    },
    "android": {
      "package": "com.squadra.squadraapp",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532D"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withDisableForceDark.js",
      "./plugins/withReleaseBuildFixes.js",
      "./plugins/withReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Kadro görüntüsünü galeriye kaydetmek için izin gerekli.",
          "savePhotosPermission": "Kadro görüntüsünü galeriye kaydetmek için izin gerekli.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3258433091491871~2816858267",
          "iosAppId": "ca-app-pub-3258433091491871~2816858267"
        }
      ]
    ],
    "extra": {}
  }
}
